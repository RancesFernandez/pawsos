rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid}/pets/{petId} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/entries/{entryId} {
      allow read, write: if isOwner(uid);
    }
    // La ficha QR pública contiene SOLO los campos elegidos para mostrar a quien escanea.
    match /publicPets/{petId} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.keys().hasOnly(['id','ownerUid','name','species','speciesOther','animalType','animalTypeOther','breed','reward','birthDate','sex','weight','color','photo','temperament','bio','ownerName','phone','whatsapp','city','allergies','conditions','medication','fears','emergencyNotes','food','foodAmount','foodSchedule','walkNotes','vetName','vetPhone','updatedAt']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Publicaciones comunitarias: solo se publican recuerdos que el usuario elige compartir.
    // No incluir aquí datos privados del perfil, contactos ni información veterinaria.
    match /sharedPaws/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.entryId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.keys().hasOnly(['ownerUid','entryId','authorName','petName','petPhoto','type','title','note','photo','entryDate','createdAt']);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.entryId == resource.data.entryId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName','petName','petPhoto','type','title','note','photo','entryDate','createdAt']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      match /reactions/{reactionUid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == reactionUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji in ['❤️','🥰','🐾','😂','👏']
          && request.resource.data.keys().hasOnly(['uid','emoji','updatedAt']);
        allow delete: if signedIn() && request.auth.uid == reactionUid;
      }
    }

    // Avisos públicos de mascotas perdidas. El contacto y la foto son visibles para cualquiera.
    match /lostPetAlerts/{alertId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'searching'
        && request.resource.data.name is string
        && request.resource.data.city is string
        && request.resource.data.contact is string
        && request.resource.data.details is string
        && request.resource.data.keys().hasOnly(['name','species','city','contact','details','photo','displayName','ownerUid','status','createdAt','createdAtServer']);
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt','resolvedBy'])
        && request.resource.data.status == 'found';
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    // Este documento contiene únicamente alias, puntos y categorías del ranking. Nunca email ni teléfono.
    match /leaderboardProfiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid','displayName','points','species','animalType','petName','updatedAt'])
        && request.resource.data.points is number
        && request.resource.data.points >= 0;
      allow delete: if isOwner(uid);
    }
  }
}
